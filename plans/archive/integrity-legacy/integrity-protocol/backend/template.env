# Smart Contract Factory
NO_CODE_FACTORY_ADDRESS=0x2e35aDd0ec480A301B02aF2619a55cE6d790d3a8
# Copy this file to .env and fill in the values

# Database Configuration
# Format: postgresql://user:password@localhost:5432/db_name
DATABASE_URL=postgresql://user:password@localhost:5432/integrity_db

# Firebase Configuration (Required for Telemetry Authentication)
# Path to your service account key file
# GOOGLE_APPLICATION_CREDENTIALS=services/firebase-credentials.json

# Blockchain Configuration (REQUIRED for Testnet Interactivity)
ETH_RPC_URL=https://sepolia.base.org
ITK_TOKEN_ADDRESS=0xF448c05074D435d256D6fbc1fC059019B86A5408
REPUTATION_REGISTRY_ADDRESS=0x7a3A63595603e8783451f2D98a6D173C33cE3094

# Master Agent / Oracle Key
# This key is used to sign AIS updates and SPONSOR guest wallets (Faucet)
XIBALBA_ORACLE_PRIVATE_KEY=your_master_agent_private_key_here
XIBALBA_ORACLE_ADDRESS=your_master_agent_eth_address_here

# SMTP Configuration (Optional for notification system)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
