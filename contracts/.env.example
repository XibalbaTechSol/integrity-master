# ─────────────────────────────────────────────────────────────────────────────
# Integrity Protocol — Environment Configuration
# Copy this file to .env and populate with your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Deployer ──────────────────────────────────────────────────────────────────
# Private key of the deployer EOA (do NOT prefix with 0x)
DEPLOYER_PRIVATE_KEY=

# ── Testnet: Ethereum Sepolia ─────────────────────────────────────────────────
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ETHERSCAN_API_KEY=

# Chainlink CCIP Router on Sepolia
CCIP_ROUTER=0x0BF3dE8c5D3e8A2B34D2BEeB17ABfCeBaf363A59

# Chainlink LINK Token on Sepolia
LINK_TOKEN=0x779877A7B0D9E8603169DdbD7836e478b4624789

# ── Testnet: Polygon Amoy ─────────────────────────────────────────────────────
AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
POLYGONSCAN_API_KEY=

# Chainlink CCIP Router on Amoy
# CCIP_ROUTER=0x9C32fCB86BF0f29Fb7EF58Ed1fFeC39fF4E1B72F
# LINK_TOKEN=0x0Fd9e8d3aF1aaee056EB9e802c3A762a667b1904

# ── Optional ──────────────────────────────────────────────────────────────────
# ZK Verifier contract address (deploy UltraPlonk verifier separately if using ZK proofs)
ZK_VERIFIER=

# Initial validator address (defaults to deployer if left empty)
VALIDATOR_ADDRESS=
